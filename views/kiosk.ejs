<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Boba Milk Tea – Order Kiosk</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Nunito+Sans:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fafafa;--card:#fff;--ink:#1a1a1a;--muted:#666;--accent:#2f6f4f;--accent-ink:#fff;--line:#ddd;--fs:20px}
body.hc{--bg:#fff;--ink:#000;--muted:#000;--accent:#005a2b;--line:#000}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font:400 var(--fs)/1.4 "Nunito Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);overflow:hidden;min-width:900px}
h1,h2,h3{font-family:"Bricolage Grotesque","Trebuchet MS",sans-serif;margin:0;line-height:1.1}
button{font:inherit;color:inherit;cursor:pointer;min-height:56px}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.sr{position:absolute;left:-9999px}
.app{display:grid;grid-template-columns:210px 1fr 340px;grid-template-rows:auto 1fr;height:100%}
header{grid-column:1/-1;display:flex;align-items:center;gap:20px;padding:14px 24px;background:var(--card);border-bottom:1px solid var(--line)}
header h1{font-size:1.5em;font-weight:800;flex:1}
header .tag{font-size:.8em;color:var(--muted)}
.tools{display:flex;gap:10px}
.tools button{background:transparent;border:1px solid var(--ink);border-radius:8px;padding:0 16px;font-weight:700;font-size:.8em}
.tools button[aria-pressed=true]{background:var(--ink);color:#fff}
nav{padding:18px 14px;display:flex;flex-direction:column;gap:6px;border-right:1px solid var(--line);overflow:auto}
nav button{background:transparent;border:0;border-radius:8px;text-align:left;padding:10px 14px;font-weight:700;color:var(--muted)}
nav button[aria-current=true]{background:var(--ink);color:#fff}
main{padding:22px 26px;overflow:auto}
main h2{font-size:1.8em;margin-bottom:4px}
main p.sub{margin:0 0 18px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}
.drink{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 12px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;min-height:240px}
.drink svg{width:72px;height:96px}
.drink h3{font-size:1.05em}
.drink .price{font-weight:700}
.drink small{color:var(--muted);font-size:.75em}
aside{background:var(--card);border-left:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
aside h2{padding:18px 20px 8px;font-size:1.3em}
#cart{flex:1;overflow:auto;padding:0 20px;list-style:none;margin:0}
#cart li{padding:12px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:2px 8px}
#cart .opts{grid-column:1;font-size:.7em;color:var(--muted)}
#cart .rm{grid-row:1/3;grid-column:2;align-self:center;background:transparent;border:1px solid var(--ink);border-radius:8px;min-width:56px;font-weight:700;font-size:.75em}
.empty{color:var(--muted);padding:20px 0}
.totals{padding:16px 20px;border-top:1px solid var(--line)}
.totals div{display:flex;justify-content:space-between;font-size:.9em}
.totals .t{font-weight:800;font-size:1.25em;margin-top:6px}
.pay{margin:0 20px 20px;background:var(--accent);color:var(--accent-ink);border:0;border-radius:10px;font-weight:800;min-height:64px}
.pay:disabled{opacity:.4;cursor:not-allowed}
.clear{margin:0 20px 12px;background:transparent;border:1px solid var(--ink);border-radius:10px}
dialog{border:0;border-radius:16px;padding:0;width:min(720px,94vw);background:var(--card);color:var(--ink);max-height:94vh}
dialog::backdrop{background:rgba(0,0,0,.5)}
.dlg{padding:24px 28px;display:grid;gap:14px}
fieldset{border:0;padding:0;margin:0}
legend{font-weight:800;margin-bottom:8px}
.choices{display:flex;flex-wrap:wrap;gap:8px}
.choices label{position:relative}
.choices input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.choices span{display:flex;align-items:center;min-height:52px;padding:0 16px;border:1px solid var(--ink);border-radius:8px;font-weight:700;font-size:.9em}
.choices input:checked+span{background:var(--ink);color:#fff}
.choices input:focus-visible+span{outline:3px solid var(--ink);outline-offset:3px}
.actions{display:flex;gap:12px;justify-content:flex-end}
.actions button{border:1px solid var(--ink);border-radius:10px;padding:0 24px;background:transparent;font-weight:800}
.actions .add{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.done{text-align:center;padding:40px 28px;display:grid;gap:14px}
.done .num{font:800 4em "Bricolage Grotesque",sans-serif}
#rotate{display:none}
@media (orientation:portrait){
  #rotate{display:flex;position:fixed;inset:0;z-index:99;background:var(--ink);color:#fff;align-items:center;justify-content:center;text-align:center;padding:30px;font-size:1.3em}
}
</style>
</head>
<body>
<div id="rotate" role="alert">Please rotate your device to landscape to place an order.</div>
<div class="app">
  <header>
    <h1>Boba Milk Tea</h1>
    <span class="tag">Tap a drink to start</span>
    <div class="tools" role="group" aria-label="Accessibility options">
      <button id="txt" aria-pressed="false">Larger text</button>
      <button id="hc" aria-pressed="false">High contrast</button>
    </div>
  </header>
  <nav id="cats" aria-label="Menu categories"></nav>
  <main id="main" tabindex="-1">
    <h2 id="catTitle"></h2>
    <p class="sub" id="catSub"></p>
    <div class="grid" id="grid"></div>
  </main>
  <aside aria-label="Your order">
    <h2>Your order</h2>
    <ul id="cart" aria-live="polite"></ul>
    <div class="totals">
      <div><span>Subtotal</span><span id="sub">$0.00</span></div>
      <div><span>Tax (8.25%)</span><span id="tax">$0.00</span></div>
      <div class="t"><span>Total</span><span id="tot">$0.00</span></div>
    </div>
    <button class="clear" id="clear">Clear order</button>
    <button class="pay" id="pay" disabled>Place order</button>
  </aside>
</div>

<dialog id="dlg" aria-labelledby="dlgTitle"></dialog>
<div class="sr" role="status" id="live"></div>

<script>
/* ---------- Menu data ----------
   Replace with your database: set MENU_URL to an Express route that returns
   [{id,name,category,price,color,desc}] and the kiosk will use it. */
const MENU_URL = '/api/menu';
const ORDER_URL = '/api/orders';
const TAX = 0.0825;

const CATS = [
  {id:'milk',  name:'Milk teas',  color:'#c98a5b', sub:'Creamy, classic, and made to order.'},
  {id:'fruit', name:'Fruit teas', color:'#f26a3d', sub:'Bright and refreshing over ice.'},
  {id:'matcha',name:'Matcha',     color:'#7bb661', sub:'Stone-ground green tea with a smooth finish.'},
  {id:'slush', name:'Slushes',    color:'#8b5fd1', sub:'Blended and frosty.'}
];
let MENU = [
  {id:1, name:'Classic Milk Tea',   category:'milk',  price:5.25, color:'#c98a5b', desc:'Black tea and milk'},
  {id:2, name:'Taro Milk Tea',     category:'milk',  price:5.75, color:'#b79ad6', desc:'Sweet purple taro'},
  {id:3, name:'Brown Sugar Milk',  category:'milk',  price:6.25, color:'#8a5a3b', desc:'Caramelized brown sugar'},
  {id:4, name:'Jasmine Milk Tea',  category:'milk',  price:5.25, color:'#e3d3a8', desc:'Floral green tea'},
  {id:5, name:'Mango Green Tea',   category:'fruit', price:5.75, color:'#f7b32b', desc:'Fresh mango, jasmine tea'},
  {id:6, name:'Passion Fruit Tea', category:'fruit', price:5.75, color:'#f2813a', desc:'Tart and tropical'},
  {id:7, name:'Strawberry Lemon',  category:'fruit', price:6.00, color:'#e8506b', desc:'Strawberry, lemon, tea'},
  {id:8, name:'Peach Oolong',      category:'fruit', price:5.75, color:'#f4a58a', desc:'Roasted oolong, peach'},
  {id:9, name:'Ceremonial Matcha Latte', category:'matcha', price:6.50, color:'#7bb661', desc:'Matcha and milk'},
  {id:10,name:'Strawberry Matcha', category:'matcha', price:6.75, color:'#a8c97a', desc:'Matcha over strawberry'},
  {id:11,name:'Mango Slush',       category:'slush', price:6.25, color:'#f7b32b', desc:'Blended mango'},
  {id:12,name:'Lychee Slush',      category:'slush', price:6.25, color:'#f1c9d4', desc:'Blended lychee'}
];
const SIZES  = [{n:'Regular',p:0},{n:'Large',p:0.75}];
const SUGAR  = ['0%','30%','50%','70%','100%'];
const ICE    = ['No ice','Less ice','Regular ice'];
const TOPS   = [{n:'Boba',p:0.75},{n:'Lychee jelly',p:0.75},{n:'Pudding',p:0.75},{n:'Aloe vera',p:0.75},{n:'Cheese foam',p:1.25}];

const $ = id => document.getElementById(id);
const money = n => '$' + n.toFixed(2);
let cat = 'milk', cart = [], lastFocus = null;

function cup(){
  return `<svg viewBox="0 0 96 120" aria-hidden="true" fill="none" stroke="#1a1a1a" stroke-width="3" stroke-linejoin="round">
    <path d="M50 4l4 26"/><rect x="10" y="30" width="76" height="10" rx="4"/>
    <path d="M16 40l6 68a8 8 0 0 0 8 7h36a8 8 0 0 0 8-7l6-68"/>
    <path d="M19 70h58" stroke="#bbb"/></svg>`;
}

function renderCats(){
  $('cats').innerHTML = CATS.map(c =>
    `<button data-c="${c.id}" aria-current="${c.id===cat}">${c.name}</button>`).join('');
}
function renderGrid(){
  const c = CATS.find(x => x.id===cat);
  $('catTitle').textContent = c.name; $('catSub').textContent = c.sub;
  $('grid').innerHTML = MENU.filter(m => m.category===cat).map(m =>
    `<button class="drink" data-id="${m.id}" aria-label="${m.name}, ${money(m.price)}. Customize and add.">
      ${cup()}<h3>${m.name}</h3><small>${m.desc||''}</small><span class="price">${money(m.price)}</span></button>`).join('');
}
function totals(){
  const sub = cart.reduce((s,i)=>s+i.price,0), tax = sub*TAX;
  $('sub').textContent = money(sub); $('tax').textContent = money(tax); $('tot').textContent = money(sub+tax);
  return {sub, tax, total: sub+tax};
}
function renderCart(){
  $('cart').innerHTML = cart.length ? cart.map((i,k)=>
    `<li><strong>${i.name}</strong><span>${money(i.price)}</span>
      <span class="opts">${i.size}, ${i.sugar} sugar, ${i.ice}${i.toppings.length?', '+i.toppings.join(', '):''}</span>
      <button class="rm" data-k="${k}" aria-label="Remove ${i.name}">Remove</button></li>`).join('')
    : '<li class="empty">Your order is empty. Pick a drink to begin.</li>';
  $('pay').disabled = !cart.length; totals();
}

function radios(name, items, checked){
  return items.map((t,i)=>{const label = t.n ? `${t.n}${t.p?` (+${money(t.p)})`:''}` : t;
    return `<label><input type="radio" name="${name}" value="${i}" ${i===checked?'checked':''}><span>${label}</span></label>`}).join('');
}
function openCustomize(m){
  lastFocus = document.activeElement;
  $('dlg').innerHTML = `<form method="dialog" class="dlg" id="f">
    <h2 id="dlgTitle">${m.name} <span style="font-weight:400">${money(m.price)}</span></h2>
    <fieldset><legend>Size</legend><div class="choices">${radios('size',SIZES,0)}</div></fieldset>
    <fieldset><legend>Sugar level</legend><div class="choices">${radios('sugar',SUGAR,4)}</div></fieldset>
    <fieldset><legend>Ice</legend><div class="choices">${radios('ice',ICE,2)}</div></fieldset>
    <fieldset><legend>Toppings</legend><div class="choices">${TOPS.map((t,i)=>
      `<label><input type="checkbox" name="top" value="${i}"><span>${t.n} (+${money(t.p)})</span></label>`).join('')}</div></fieldset>
    <div class="actions"><button type="button" id="cx">Cancel</button><button class="add" type="submit">Add to order</button></div></form>`;
  $('dlg').showModal();
  $('cx').onclick = () => $('dlg').close();
  $('f').onsubmit = e => {
    e.preventDefault();
    const f = new FormData($('f')), size = SIZES[f.get('size')];
    const tops = f.getAll('top').map(i => TOPS[i]);
    cart.push({id:m.id, name:m.name, size:size.n, sugar:SUGAR[f.get('sugar')], ice:ICE[f.get('ice')],
      toppings:tops.map(t=>t.n), price:m.price+size.p+tops.reduce((s,t)=>s+t.p,0)});
    $('dlg').close(); renderCart(); $('live').textContent = m.name + ' added to your order.';
  };
}
$('dlg').addEventListener('close', () => lastFocus && lastFocus.focus());

async function placeOrder(){
  const t = totals(); let num = Math.floor(100 + Math.random()*900);
  $('pay').disabled = true;
  try{
    const r = await fetch(ORDER_URL,{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({source:'kiosk', items:cart, subtotal:t.sub, tax:t.tax, total:t.total})});
    if(r.ok){ const d = await r.json(); num = d.orderNumber || d.id || num; }
  }catch(e){ console.warn('Order endpoint not reachable yet; showing demo confirmation.', e); }
  $('dlg').innerHTML = `<div class="done"><h2 id="dlgTitle">Thanks! Your order is in.</h2>
    <div class="num" aria-label="Order number ${num}">#${num}</div>
    <p>Listen for your number at the counter.</p>
    <div class="actions" style="justify-content:center"><button class="add" id="ok">Start a new order</button></div></div>`;
  $('dlg').showModal(); $('ok').onclick = () => $('dlg').close();
  cart = []; renderCart();
}

$('cats').onclick = e => { const b = e.target.closest('button'); if(!b) return; cat = b.dataset.c; renderCats(); renderGrid(); };
$('grid').onclick = e => { const b = e.target.closest('.drink'); if(b) openCustomize(MENU.find(m => m.id==b.dataset.id)); };
$('cart').onclick = e => { const b = e.target.closest('.rm'); if(b){ cart.splice(b.dataset.k,1); renderCart(); } };
$('clear').onclick = () => { cart = []; renderCart(); };
$('pay').onclick = placeOrder;
$('hc').onclick = e => { const on = document.body.classList.toggle('hc'); e.currentTarget.setAttribute('aria-pressed', on); };
$('txt').onclick = e => { const on = e.currentTarget.getAttribute('aria-pressed')!=='true';
  document.documentElement.style.setProperty('--fs', on ? '24px' : '20px'); e.currentTarget.setAttribute('aria-pressed', on); };

(async function init(){
  try{
    const r = await fetch(MENU_URL);
    if(r.ok){ const d = await r.json(); if(Array.isArray(d) && d.length) MENU = d.map(x => ({...x, price:Number(x.price)})); }
  }catch(e){ /* keep built-in menu */ }
  renderCats(); renderGrid(); renderCart();
})();
</script>
</body>
</html>
